# PostgreSQL (Primary Workflow & Job Leasing DB)
POSTGRES_USER=flowmesh
POSTGRES_PASSWORD=flowmesh_secret
POSTGRES_DB=flowmesh
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flowmesh:flowmesh_secret@localhost:5432/flowmesh

# TimescaleDB (Telemetry, Execution Logs & Metrics)
TIMESCALE_USER=flowmesh_telemetry
TIMESCALE_PASSWORD=flowmesh_telemetry_secret
TIMESCALE_DB=flowmesh_telemetry
TIMESCALE_PORT=5433
TELEMETRY_DATABASE_URL=postgresql://flowmesh_telemetry:flowmesh_telemetry_secret@localhost:5433/flowmesh_telemetry

# Redis (CRDT Pub/Sub, Heartbeats, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Service Ports
PORT_WEB=3000
PORT_API=4000
PORT_SYNC=4001
PORT_WORKER=4002
